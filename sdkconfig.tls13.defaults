# ESP-IDF 6.1.1 / Arduino 4.0.0 defaults for the Waveshare ESP32-S3 Wi-Fi bridge (TLS 1.3).
# Standard ESP32 envs use sdkconfig.defaults (also on ESP-IDF 6.1.1).
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="min_spiffs.csv"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ── Wi-Fi / TCP / NAPT throughput & stability tuning ──────────────────────────
# Keep local TCP window/send buffer at 5760 to preserve heap margin for dual
# TLS + NAPT + OTA (NAPT L3 forwarding bypasses local TCP buffers).
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
# 20 BSD sockets: 443 (1+1+3) + 4567 (1+1+3) + DNS (2) + async proxy (2) + headroom.
CONFIG_LWIP_MAX_SOCKETS=20
CONFIG_LWIP_TCP_RECVMBOX_SIZE=12
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_SACK_OUT=y
CONFIG_LWIP_IRAM_OPTIMIZATION=y
# Dedicated L2 (Core 0 Wi-Fi) / L3 (Core 1 lwIP + NAPT + DNSFilter) pipeline
# on FSD_MOCK_ONLY builds (no CAN task on Core 1).
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y
# Match STATIC_RX_BUFFER_NUM >= RX_BA_WIN so 16-frame AMPDU bursts never exhaust
# RX DMA buffers; enable extra Wi-Fi IRAM hot paths for higher forwarding speed.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_TX_BA_WIN=16
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=y
# Trim unused stacks to recover RAM/Flash without affecting any bridge feature.
# (LWIP_PPP_SUPPORT is kept selected by Arduino 3.x Network/PPP component.)
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
# CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT is not set

# ── Wi-Fi bridge: IPv4-only forwarding + NAPT (IPv6 strictly disabled) ────────
CONFIG_LWIP_L2_TO_L3_COPY=y
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
# CONFIG_LWIP_IPV4_NAPT_PORTMAP is not set
# CONFIG_LWIP_IPV6 is not set
# CONFIG_LWIP_IPV6_FORWARD is not set
# CONFIG_LWIP_IPV6_AUTOCONFIG is not set
# CONFIG_LWIP_ESP_MLDV6_REPORT is not set
# CONFIG_LWIP_PPP_ENABLE_IPV6 is not set
# Disable unused esp-modbus TCP/mDNS (requires IPv6 mdns_query_aaaa).
# CONFIG_FMB_COMM_MODE_TCP_EN is not set
# CONFIG_FMB_MDNS_INTEGRATION_ENABLE is not set

# ── TLS: negotiate TLS 1.2 or TLS 1.3 (TeslaDG matches this: min TLS1_2,
#    max unbounded). mbedTLS 3.6 has no TLS 1.0/1.1 options; 1.2 is the floor.
# The FSD mock needs the HTTPS server component for the 443 vehicle listener;
# the 4567 mothership listener uses the plain httpd component.
# Tesla JWT/cookie and browser headers routinely exceed IDF's 1024 B default
# (causing 431 "Header fields are too long" before fsd_mock runs). In IDF 5.5
# httpd scratch buffers are realloc'd on demand per request and freed on exit,
# so 8192 B adds zero idle RAM overhead.
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
# Disable unused HTTP/HTTPS server default-event-loop posts on every recv/send.
# CONFIG_ESP_HTTPS_SERVER_EVENTS is not set
# CONFIG_HTTPD_ENABLE_EVENTS is not set
CONFIG_HTTPD_MAX_REQ_HDR_LEN=8192
CONFIG_HTTPD_MAX_URI_LEN=1024
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=6144
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# Keep DYNAMIC_BUFFER disabled: IDF 6.1.1 esp_ssl_srv.c:58 frees the RX buffer
# without checking ssl->keep_current_message on TLS 1.3->1.2 ClientHello fallback,
# deadlocking TLS 1.2 clients. Use 8 MB Octal PSRAM (with safe IGNORE_NOTFOUND
# fallback) + DEFAULT_MEM_ALLOC so multi-socket TLS uses PSRAM without OOM.
# CONFIG_MBEDTLS_DYNAMIC_BUFFER is not set
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
# Match aa0a69f8b hardware-only MPI and trim unused mbedTLS self-tests.
# CONFIG_MBEDTLS_LARGE_KEY_SOFTWARE_MPI is not set
# CONFIG_MBEDTLS_SELF_TEST is not set
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=y

# ── PSRAM (Waveshare ESP32-S3R8 8 MB Octal PSRAM; safe fallback if absent) ───
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Upstream is intentionally insecure, matching TeslaDG start_hotspot.ps1
# (mitmdump --set ssl_insecure=true). Tesla's api-prd certificate is issued
# by a private CA that is not in the public bundle.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
