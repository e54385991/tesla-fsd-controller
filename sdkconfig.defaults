CONFIG_AUTOSTART_ARDUINO=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE_DETECT=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="min_spiffs.csv"
CONFIG_LWIP_L2_TO_L3_COPY=y
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# ── Wi-Fi / TCP throughput & stability tuning ─────────────────────────────────
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LWIP_TCP_WND_DEFAULT=11520
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520
CONFIG_TCP_WND_DEFAULT=11520
CONFIG_TCP_SND_BUF_DEFAULT=11520
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_TCP_RECVMBOX_SIZE=12
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=48
CONFIG_LWIP_TCP_SACK_OUT=y
# Move lwip hot paths into IRAM. +10-20% throughput, costs ~10 KB IRAM.
CONFIG_LWIP_IRAM_OPTIMIZATION=y
# Dedicated L2 (Core 0 Wi-Fi) / L3 (Core 1 lwIP + NAPT + DNSFilter) pipeline.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y
# Align STATIC_RX_BUFFER_NUM >= RX_BA_WIN (IDF 4.4 ESP32 sweet spot = 12).
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=12
CONFIG_ESP32_WIFI_TX_BA_WIN=12
CONFIG_ESP32_WIFI_RX_BA_WIN=12

# Dual TLS (vehicle server + upstream client): keep record buffers small.
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=6144
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# Match TeslaDG mitmproxy tls_version_{client,server}_min=TLS1_2. With
# mbedTLS 2.28 (ESP-IDF 4.4) TLS 1.2 is also the maximum:
# CONFIG_MBEDTLS_SSL_PROTO_TLS1_3 does not exist here, so the car-facing 443
# listener and the upstream client can never negotiate TLS 1.3 (mitmproxy's
# default maximum is unbounded).
# Compiling out TLS 1.0/1.1 makes mbedTLS's default minimum TLS 1.2 instead
# of TLS 1.0, so a legacy client cannot downgrade below the TeslaDG floor.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
# CONFIG_MBEDTLS_SSL_PROTO_TLS1 is not set
# CONFIG_MBEDTLS_SSL_PROTO_TLS1_1 is not set
# Upstream is intentionally insecure, matching TeslaDG start_hotspot.ps1
# (mitmdump --set ssl_insecure=true). Tesla's api-prd certificate is issued
# by a private CA that is not in the public bundle.
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
